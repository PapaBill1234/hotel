APP_NAME="Hotel CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hotel.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel-owned schema. Migrations run only here.
DB_CONNECTION=sys
SYS_DB_HOST=host.docker.internal
SYS_DB_PORT=3306
SYS_DB_DATABASE=hotel_cms_sys
SYS_DB_USERNAME=root
SYS_DB_PASSWORD=

# PolarIS / PHPRetro hotel schema. SELECT only. Never migrate.
HOLODB_HOST=host.docker.internal
HOLODB_PORT=3306
HOLODB_DATABASE=phpretro
HOLODB_USERNAME=root
HOLODB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=hotel_session
LEGACY_COOKIE_NAME=PHPSESSID

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default

CACHE_STORE=redis
CACHE_PREFIX=hotel_
REDIS_CACHE_CONNECTION=cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=hotel_
# 0 cache, 1 sessions, 2 queues/Horizon, 3 flags
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_DB=2
REDIS_FLAGS_DB=3

HORIZON_PREFIX=hotel_horizon:
HORIZON_PATH=horizon

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@hotel.test"
MAIL_FROM_NAME="${APP_NAME}"

LEGACY_URL=http://host.docker.internal:8080
LEGACY_GALLERY_PROBE=/web-gallery/v2/styles/style.css

VITE_APP_NAME="${APP_NAME}"
